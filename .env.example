# ⚙️ Security Testing - Environment Variables
# Copy this file to .env and adjust the values

# API Base URL (fallback: https://serverest.dev)
API_BASE_URL=https://serverest.dev

# Credentials for tests (fallback values in code)
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMMON_USER_EMAIL=
COMMON_USER_PASSWORD=

# Test configuration
TEST_TIMEOUT=60000
TEST_RETRIES=0

# Allure Reporting
ALLURE_RESULTS_DIR=allure-results

