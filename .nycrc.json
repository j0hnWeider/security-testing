{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "reporter": ["html", "text", "lcov"],
  "report-dir": "reports/coverage",
  "check-coverage": true,
  "branches": 40,
  "lines": 50,
  "functions": 50,
  "statements": 50
}
